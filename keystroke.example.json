{
  "version": 1,
  "palette": {
    "density": "compact",
    "accent": "theme",
    "showPreview": true,
    "animations": "snappy",
    "windowTransition": "fade"
  },
  "voice": {
    "enabled": true,
    "secondTap": "voice",
    "keys": "SUPER + SPACE"
  },
  "matching": {
    "mode": "all",
    "model": "small"
  },
  "providers": {
    "omarchy": {
      "enabled": true,
      "confirmDestructive": true
    },
    "applications": {
      "enabled": true
    },
    "calculator": {
      "enabled": true,
      "precision": 12
    },
    "converter": {
      "enabled": true,
      "timezone": ""
    },
    "colors": {
      "enabled": true,
      "format": "hex"
    },
    "emoji": {
      "enabled": true
    },
    "clipboard": {
      "enabled": true,
      "limit": 100
    },
    "files": {
      "enabled": true,
      "searchMode": "fuzzy",
      "files": true,
      "folders": true,
      "hidden": false,
      "limit": 10
    },
    "ai": {
      "enabled": true,
      "provider": "chatgpt",
      "mode": "desktop",
      "autoSend": false
    },
    "settings": {
      "enabled": true
    },
    "example.keystroke-hello": {
      "enabled": false,
      "greeting": "Hello"
    },
    "claude": {
      "enabled": true,
      "model": "claude-opus-5",
      "effort": "low",
      "destination": "cli",
      "workspace": ""
    },
    "extensions": {
      "enabled": true,
      "marketplace": true,
      "autoCheck": true,
      "indexUrl": "https://raw.githubusercontent.com/evindor/keystroke/main/extensions/index.json"
    },
    "io.github.evindor.keystroke-timer": {
      "enabled": true,
      "defaultMinutes": 5,
      "notify": true
    }
  }
}
